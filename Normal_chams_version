-- ==========================================
-- БЛОК 4: ЧЕПСЫ ЛОГИКА БРОТЬИ
-- ==========================================
local chamsEnabled = false -- Изначально чамсы выключены

-- Внутренняя функция создания подсветки
local function applyChams(character)
    if not chamsEnabled then return end -- Если чит выключен кнопкой, ничего не делаем
    if character == game:GetService("Players").LocalPlayer.Character then return end
    if character:FindFirstChild("ZOVChams") then return end

    local highlight = Instance.new("Highlight")
    highlight.Name = "ZOVChams"
    highlight.FillColor = Color3.fromRGB(255, 0, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = character
end

-- Функция ПОЛНОГО УДАЛЕНИЯ всех чамсов с карты
local function removeChams()
    for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
        if player.Character then
            local highlight = player.Character:FindFirstChild("ZOVChams")
            if highlight then
                highlight:Destroy() -- Удаляем подсветку через её имя
            end
        end
    end
end

-- Обработчик клика по кнопке Чамсов
chamsButton.MouseButton1Click:Connect(function()
    chamsEnabled = not chamsEnabled -- Меняем true на false (или наоборот)

    if chamsEnabled then
        -- Если ВКЛЮЧИЛИ: меняем дизайн кнопки и подсвечиваем текущих игроков
        chamsButton.Text = "ЧЕПСЫ: ВКЛ"
        chamsButton.TextColor3 = Color3.fromRGB(80, 255, 80) -- Зеленый текст
        
        for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
            if player.Character then applyChams(player.Character) end
        end
    else
        -- Если ВЫКЛЮЧИЛИ: возвращаем дизайн кнопки и стираем чамсы
        chamsButton.Text = "ЧЕПСЫ: ВЫКЛ"
        chamsButton.TextColor3 = Color3.fromRGB(255, 80, 80) -- Красный текст
        removeChams()
    end
end)

-- Авто-подсветка при респавне или заходе новых игроков (сработает только если chamsEnabled == true)
game:GetService("Players").PlayerAdded:Connect(function(player)
    player.CharacterAdded:Connect(applyChams)
end)
for _, player in ipairs(game:GetService("Players"):GetPlayers()) do
    player.CharacterAdded:Connect(applyChams)
end

-- ==========================================
-- ПЕРЕТАСКИВАНИЕ ЦЕБУЛЯ
-- ==========================================
local UIS = game:GetService("UserInputService")
local dragging, dragInput, dragStart, startPos
local function update(input)
    local delta = input.Position - dragStart
    mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
end
mainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true dragStart = input.Position startPos = mainFrame.Position
        input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
    end
end)
mainFrame.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)
UIS.InputChanged:Connect(function(input) if input == dragInput and dragging then update(input) end end)
